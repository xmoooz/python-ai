# Shared / selector file. Copy to `.env`.
# Docker Compose only reads this file. The app then loads `.env.<APP_ENV>`.
#
#   copy .env.example .env
#   copy .env.dev.example .env.dev
#   uvicorn app.main:app --reload

APP_ENV=dev

# Postgres (must match docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

TZ=UTC
PGTZ=UTC

# Raise these together if HNSW index builds fail with shared-memory errors.
POSTGRES_SHM_SIZE=256mb
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_WORK_MEM=8MB
POSTGRES_MAINTENANCE_WORK_MEM=128MB

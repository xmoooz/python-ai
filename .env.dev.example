# Copy to `.env.dev` (APP_ENV=dev).
# Overrides `.env`. Empty keys are ignored.

APP_NAME=AI Microservice
APP_VERSION=0.1.0
DEBUG=true
ENABLE_DOCS=true
LOG_LEVEL=DEBUG

HOST=127.0.0.1
PORT=8000

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_POOL_MIN_SIZE=2
POSTGRES_POOL_MAX_SIZE=10

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Protects POST /jobs/crawl. Replace this value in your untracked `.env.dev`.
JOB_INGESTION_KEY=change-me
JOB_SOURCE_HOSTS=boards.greenhouse.io,jobs.lever.co

# Copy to `.env.test` (APP_ENV=test).
# Use a separate database so tests never touch dev data.

DEBUG=true
ENABLE_DOCS=false
LOG_LEVEL=WARNING

HOST=127.0.0.1
PORT=8000

CORS_ORIGINS=

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app_test
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=2

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

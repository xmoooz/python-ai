# Copy to `.env.staging` (APP_ENV=staging).
# Near-production: docs on, debug off.

DEBUG=false
ENABLE_DOCS=true
LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=8000

CORS_ORIGINS=https://staging.example.com

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_POOL_MIN_SIZE=2
POSTGRES_POOL_MAX_SIZE=10

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

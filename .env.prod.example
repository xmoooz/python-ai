# Copy to `.env.prod` (APP_ENV=prod).
# Do not commit `.env.prod`. Password default "app" is rejected in this profile.

DEBUG=false
ENABLE_DOCS=false
LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=8000

CORS_ORIGINS=https://app.example.com

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app
POSTGRES_POOL_MIN_SIZE=5
POSTGRES_POOL_MAX_SIZE=20

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

JOB_INGESTION_KEY=change-me
JOB_SOURCE_HOSTS=careers.example.com
